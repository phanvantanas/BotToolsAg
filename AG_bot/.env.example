# ==========================================
# CẤU HÌNH ANTIGRAVITY TELEGRAM REMOTE BOT
# ==========================================

# 1. Token của Bot lấy từ @BotFather trên Telegram (Bắt buộc)
# Ví dụ: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram User ID của bạn lấy từ @userinfobot (Bắt buộc)
# Chỉ những ID trong danh sách này mới điều khiển được bot (cách nhau bởi dấu phẩy nếu có nhiều ID)
# Ví dụ: 123456789,987654321
ALLOWED_USER_IDS=123456789

# 3. Mã PIN bảo mật khi thực hiện lệnh nguy hiểm (Tắt máy, Khởi động lại)
SECURITY_PIN=1234

# 4. Model Antigravity mặc định khi khởi động
# Các tùy chọn: gemini-3.8-flash-high, gemini-3.8-flash-medium, claude-sonnet-4-6, claude-opus-4-6-thinking
DEFAULT_MODEL=gemini-3.8-flash-high

# 5. Đường dẫn đến file agy.exe (Mặc định tự nhận diện theo User: C:\Users\<Username>\.gemini\bin\agy.exe)
# Nếu agy.exe nằm ở vị trí khác, bạn có thể bỏ chú thích dòng dưới và điền đúng đường dẫn:
# AGY_PATH=C:\Users\YourUsername\.gemini\bin\agy.exe
